# Mobile build environment variables
# Set VITE_API_BASE_URL to your deployed Replit backend URL before running:
#   pnpm build:mobile && npx cap sync
#
# Find your URL in the Replit dashboard after publishing.
# Format: https://your-app-name.replit.app
#
# For Codemagic CI: add VITE_API_BASE_URL as an environment variable
# in your Codemagic workflow settings.

VITE_API_BASE_URL=
